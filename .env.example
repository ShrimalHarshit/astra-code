# Copy to .env for LOCAL runs only. On Kaggle use Add-ons -> Secrets (see README). NEVER commit real values.
# Supabase: use the *pooler* connection string (Kaggle is IPv4-only; the direct db.<ref>.supabase.co host is IPv6-only).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=
GITHUB_TOKEN=
ASTRA_API_TOKEN=
# Optional overrides
# ASTRA_WORK_DIR=
# ASTRA_MODELS_DIR=
# ASTRA_BACKEND=mock
